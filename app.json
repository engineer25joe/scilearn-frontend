{
  "expo": {
    "name": "SCI LEARN",
    "slug": "scilearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scilearn",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.engineer25joe.scilearn"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "react-native-video"
    ],
    "permissions": [
     "READ_EXTERNAL_STORAGE",
     "WRITE_EXTERNAL_STORAGE",
     "MANAGE_EXTERNAL_STORAGE"
    ]
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d21d4ea5-fc25-4007-8405-b08a18b338b2"
      }
    }
  }
}
