{
  "expo": {
    "name": "SCI LEARN",
    "slug": "scilearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scilearn",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#006600"
      },
      "package": "com.engineer25joe.scilearn",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/react-logo.png",
          "color": "#006600",
          "sounds": []
        }
      ],
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "react-native-video",
      "expo-sharing"
    ],
    "permissions": [
      "READ_EXTERNAL_STORAGE",
      "WRITE_EXTERNAL_STORAGE",
      "MANAGE_EXTERNAL_STORAGE"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9e426b9-ae03-4a9e-956d-be1c1cdf7000"
      }
    },
    "owner": "scibase"
  }
}
